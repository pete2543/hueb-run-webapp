# คัดลอกเป็น .env.local แล้วแก้ค่า ห้าม commit ไฟล์ .env.local
# URL ของ ASP.NET Core API (docs/api-contract.md)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5144/api/v1

# ใช้ข้อมูลจำลองแทน API จริง (ค่าเริ่มต้น true) ตั้ง false เมื่อ API พร้อม
API_MOCK=true
NEXT_PUBLIC_EVENT_SLUG=hueb-run-2027

# ลิงก์เพิ่มเพื่อน LINE OA (หน้าสมัครสำเร็จ)
NEXT_PUBLIC_LINE_OA_URL=

# LIFF ID จาก LINE Login channel (แท็บ LIFF) ใช้ผูก LINE กับใบสมัครเพื่อรับแจ้งเตือน — ไม่ตั้ง = ซ่อนปุ่มผูก LINE
# ต้องตั้ง Endpoint URL ของ LIFF เป็นโดเมนของหน้าบ้านนี้ และ scope openid + profile
NEXT_PUBLIC_LIFF_ID=

# หลังบ้าน: ความลับสำหรับลงลายเซ็น session (production ต้องตั้งเป็นค่าสุ่มยาว ๆ)
ADMIN_SESSION_SECRET=
# รหัสผ่านบัญชีทดสอบหลังบ้าน (เฉพาะโหมดข้อมูลจำลอง ทุกบัญชีใช้รหัสเดียวกัน)
ADMIN_DEMO_PASSWORD=hueb-demo-2027
